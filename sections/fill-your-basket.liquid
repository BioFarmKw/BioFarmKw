{% schema %}
{
  "name": "Fill Your Basket",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Fill Your Basket"
    },
    {
      "type": "header",
      "content": "Vegetable Basket"
    },
    {
      "type": "product",
      "id": "vegetable_product",
      "label": "Vegetable Product (Fixed 9.500 KD)"
    },
    {
      "type": "header",
      "content": "Fish Categories"
    },
    {
      "type": "product",
      "id": "fish_small",
      "label": "Small Fish (1.5 KD/kg)"
    },
    {
      "type": "product",
      "id": "fish_small_medium",
      "label": "Small Medium Fish (1.750 KD/kg)"
    },
    {
      "type": "product",
      "id": "fish_medium",
      "label": "Medium Fish (2 KD/kg)"
    },
    {
      "type": "product",
      "id": "fish_large",
      "label": "Large Fish (2.5 KD/kg)"
    }
  ],
  "presets": [
    {
      "name": "Fill Your Basket"
    }
  ]
}
{% endschema %}

<style>
  .fill-basket-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px;
    font-family: inherit;
  }
  .fill-basket-header {
    text-align: center;
    margin-bottom: 40px;
  }
  .fill-basket-header h2 {
    font-size: 32px;
    font-weight: bold;
    color: var(--color-foreground, #333);
  }
  .fill-basket-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
  }
  @media(min-width: 768px) {
    .fill-basket-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .basket-card {
    background: #ffffff;
    border-radius: 12px;
    padding: 24px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    border: 1px solid #eee;
  }
  .basket-card h3 {
    font-size: 20px;
    margin-bottom: 15px;
    color: #222;
    border-bottom: 2px solid #eee;
    padding-bottom: 10px;
  }
  
  /* Vegetable Toggle */
  .veg-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 15px;
    border: 2px solid #e0e0e0;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .veg-toggle.active {
    border-color: #4CAF50;
    background-color: #f1f8e9;
  }
  .veg-toggle input {
    display: none;
  }
  .veg-price {
    font-weight: bold;
    color: #4CAF50;
    font-size: 18px;
  }

  /* Fish Selection */
  .fish-option {
    display: flex;
    flex-direction: column;
    padding: 15px;
    border: 1px solid #eee;
    border-radius: 8px;
    margin-bottom: 15px;
    transition: all 0.2s;
  }
  .fish-option:focus-within {
    border-color: #2196F3;
    background: #f0f7ff;
  }
  .fish-details {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }
  .fish-title {
    font-weight: bold;
    font-size: 16px;
  }
  .fish-weight {
    font-size: 12px;
    color: #666;
  }
  .fish-price {
    font-weight: bold;
    color: #2196F3;
    margin-bottom: 5px;
  }
  .fish-qty-control {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 5px;
  }
  .fish-qty-control input {
    width: 70px;
    padding: 5px;
    border: 1px solid #ccc;
    border-radius: 4px;
    text-align: center;
  }
  .fish-qty-control span {
    font-weight: bold;
    font-size: 12px;
    color: #666;
  }

  .qty-selector {
    margin-top: 20px;
  }
  .qty-selector label {
    display: block;
    font-weight: bold;
    margin-bottom: 8px;
  }
  .qty-input-group {
    display: flex;
    align-items: center;
  }
  .qty-input-group input {
    width: 80px;
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 4px;
    text-align: center;
    font-size: 16px;
  }
  .qty-unit {
    margin-left: 10px;
    font-weight: bold;
    color: #555;
  }

  /* Summary Section */
  .basket-summary {
    grid-column: 1 / -1;
    background: #fafafa;
    border-radius: 12px;
    padding: 24px;
    text-align: center;
    border: 1px solid #eee;
  }
  .subtotal-display {
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 20px;
    color: #333;
  }
  .add-to-basket-btn {
    background-color: #222;
    color: #fff;
    border: none;
    padding: 15px 40px;
    font-size: 18px;
    font-weight: bold;
    border-radius: 30px;
    cursor: pointer;
    transition: all 0.3s;
  }
  .add-to-basket-btn:hover {
    background-color: #4CAF50;
    transform: translateY(-2px);
  }
  .add-to-basket-btn:disabled {
    background-color: #ccc;
    cursor: not-allowed;
    transform: none;
  }
  
  .error-message {
    color: #d32f2f;
    margin-top: 10px;
    font-size: 14px;
    display: none;
  }

  .basket-summary-details {
    margin-bottom: 20px;
    padding: 15px;
    background: #fff;
    border-radius: 8px;
    border: 1px dashed #ccc;
    text-align: left;
  }
  .summary-line {
    margin-bottom: 5px;
    font-size: 15px;
  }
  .summary-line strong {
    color: #555;
  }
</style>

<modal-dialog id="Fill-Basket-Modal" class="modal">
  <div class="modal-overlay"></div>
  <div class="modal-inner gradient focus-none" role="dialog" data-trap aria-modal="true" tabindex="-1">
    <button class="modal-close-button button button--icon button--pill button--float" onclick="this.closest('.modal').hide()">
      {% render 'icon-sets-basic', icon: 'close' %}
    </button>
    <div class="modal-content" style="max-height: 90vh; overflow-y: auto; padding: 20px;">
      
      <div class="fill-basket-section" id="Fill-Basket-{{ section.id }}">
  <div class="fill-basket-header">
    <h2>{{ section.settings.title | escape }}</h2>
  </div>

  <div class="fill-basket-grid">
    <!-- Left Column (Formerly Vegetables) -->
    <div class="basket-card">
      <h3>Fish Basket</h3>
      <label class="veg-toggle" id="vegToggleLabel">
        <span>Fresh Fish</span>
        <span class="veg-price">10.000 KD</span>
        <input type="checkbox" id="vegCheckbox" 
          data-variant-id="{{ section.settings.vegetable_product.first_available_variant.id }}" 
          data-price="10.0">
      </label>
    </div>

    <!-- Fish -->
    <div class="basket-card">
      <h3>Fish Basket</h3>
      
      {% assign fish_small = section.settings.fish_small %}
      {% assign fish_sm_med = section.settings.fish_small_medium %}
      {% assign fish_medium = section.settings.fish_medium %}
      {% assign fish_large = section.settings.fish_large %}

      <div class="fish-options">
        <div class="fish-option">
          <div class="fish-details">
            <span class="fish-title">Fresh Small Fish</span>
            <span class="fish-weight">500g - 600g</span>
          </div>
          <div class="fish-price">1.500 KD / kg</div>
          <div class="fish-qty-control">
            <input type="number" class="fish-qty-input" data-category="Fresh Small Fish" data-variant-id="{{ fish_small.first_available_variant.id }}" data-price="1.5" min="0" step="1" value="0">
            <span>KG</span>
          </div>
        </div>

        <div class="fish-option">
          <div class="fish-details">
            <span class="fish-title">Fresh Small Medium Fish</span>
            <span class="fish-weight">650g - 750g</span>
          </div>
          <div class="fish-price">1.750 KD / kg</div>
          <div class="fish-qty-control">
            <input type="number" class="fish-qty-input" data-category="Fresh Small Medium Fish" data-variant-id="{{ fish_sm_med.first_available_variant.id }}" data-price="1.75" min="0" step="1" value="0">
            <span>KG</span>
          </div>
        </div>

        <div class="fish-option">
          <div class="fish-details">
            <span class="fish-title">Fresh Medium Fish</span>
            <span class="fish-weight">800g - 2000g</span>
          </div>
          <div class="fish-price">2.000 KD / kg</div>
          <div class="fish-qty-control">
            <input type="number" class="fish-qty-input" data-category="Fresh Medium Fish" data-variant-id="{{ fish_medium.first_available_variant.id }}" data-price="2.0" min="0" step="1" value="0">
            <span>KG</span>
          </div>
        </div>

        <div class="fish-option">
          <div class="fish-details">
            <span class="fish-title">Fresh Large Fish</span>
            <span class="fish-weight">Above 2000g</span>
          </div>
          <div class="fish-price">2.500 KD / kg</div>
          <div class="fish-qty-control">
            <input type="number" class="fish-qty-input" data-category="Fresh Large Fish" data-variant-id="{{ fish_large.first_available_variant.id }}" data-price="2.5" min="0" step="1" value="0">
            <span>KG</span>
          </div>
        </div>
      </div>

      <div class="qty-selector" style="margin-top: 15px; padding-top: 10px; border-top: 1px solid #eee;">
        <div id="fishQtyError" class="error-message" style="display:none;">Total fish weight must be at least 5 KG.</div>
      </div>
    </div>

    <!-- Summary -->
    <div class="basket-summary">
      <div id="basketSummaryDetails" class="basket-summary-details">
        <div class="summary-line"><strong>Total Fish Weight:</strong> <span id="summaryWeight">0</span> KG</div>
        <div class="summary-line"><strong>Selected Items:</strong> <span id="summaryItems">None</span></div>
      </div>
      <div class="subtotal-display">
        Subtotal: <span id="basketSubtotal">0.000 KD</span>
      </div>
      <button class="add-to-basket-btn" id="addToBasketBtn">Add to Basket</button>
      <div id="basketError" class="error-message"></div>
    </div>
  </div>
</div>
  </div>
</modal-dialog>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const vegCheckbox = document.getElementById('vegCheckbox');
    const vegToggleLabel = document.getElementById('vegToggleLabel');
    const fishQtyInputs = document.querySelectorAll('.fish-qty-input');
    const subtotalDisplay = document.getElementById('basketSubtotal');
    const addToBasketBtn = document.getElementById('addToBasketBtn');
    const fishQtyError = document.getElementById('fishQtyError');
    const basketError = document.getElementById('basketError');

    function calculateSubtotal() {
      let total = 0;
      let summaryItems = [];
      let totalFishWeight = 0;
      
      // Left Column Fish
      if (vegCheckbox.checked) {
        total += parseFloat(vegCheckbox.dataset.price || 0);
        summaryItems.push("Fresh Fish (Fixed)");
        vegToggleLabel.classList.add('active');
      } else {
        vegToggleLabel.classList.remove('active');
      }

      // Fish Loop
      fishQtyInputs.forEach(input => {
        let qty = parseInt(input.value) || 0;
        if (qty > 0) {
          let price = parseFloat(input.dataset.price || 0);
          total += (price * qty);
          totalFishWeight += qty;
          summaryItems.push(`${qty} KG ${input.dataset.category}`);
        }
      });

      subtotalDisplay.textContent = total.toFixed(3) + ' KD';
      
      // Update Summary UI
      document.getElementById('summaryWeight').textContent = totalFishWeight;
      document.getElementById('summaryItems').textContent = summaryItems.length > 0 ? summaryItems.join(', ') : "None";
      
      // Validation UI
      if (totalFishWeight > 0 && totalFishWeight < 5) {
        fishQtyError.style.display = 'block';
        addToBasketBtn.disabled = true;
        addToBasketBtn.textContent = "Min. 5 KG Fish Required";
      } else {
        fishQtyError.style.display = 'none';
        
        // Check if total matches minimum requirement (10 KD)
        if (total >= 10) {
          addToBasketBtn.disabled = false;
          addToBasketBtn.textContent = "Proceed to Payment";
        } else if (total > 0) {
          addToBasketBtn.disabled = true;
          addToBasketBtn.textContent = "Min. 10 KD Required";
        } else {
          addToBasketBtn.disabled = true;
          addToBasketBtn.textContent = "Add to Basket";
        }
      }
    }

    vegCheckbox.addEventListener('change', calculateSubtotal);
    fishQtyInputs.forEach(input => input.addEventListener('input', calculateSubtotal));

    addToBasketBtn.addEventListener('click', function() {
      let items = [];
      let totalFishWeight = 0;
      let missingProduct = false;

      // Left Column Fish (Fixed Price)
      if (vegCheckbox.checked) {
        const vId = vegCheckbox.dataset.variantId;
        if (vId && vId !== "") {
          items.push({
            id: vId,
            quantity: 1
          });
        } else {
          missingProduct = true;
        }
      }

      // Right Column Fish (By Weight)
      fishQtyInputs.forEach(input => {
        let qty = parseInt(input.value) || 0;
        if (qty > 0) {
          totalFishWeight += qty;
          const vId = input.dataset.variantId;
          if (vId && vId !== "") {
            items.push({
              id: vId,
              quantity: qty,
              properties: {
                '_is_fish': 'true'
              }
            });
          } else {
            missingProduct = true;
          }
        }
      });

      if (missingProduct) {
        basketError.textContent = "Error: Please go to the Theme Editor (Online Store > Customize) and assign products to all fields in the 'Fill Your Basket' section.";
        basketError.style.display = 'block';
        return;
      }

      if (items.length === 0) {
        basketError.textContent = "Please select items to add to your basket.";
        basketError.style.display = 'block';
        return;
      }

      basketError.style.display = 'none';
      addToBasketBtn.disabled = true;
      addToBasketBtn.textContent = "Adding...";

      // AJAX Add to Cart
      fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ items: items })
      })
      .then(response => {
        if (response.ok) {
          // Success: redirect to checkout
          addToBasketBtn.textContent = "Redirecting...";
          window.location.href = '/checkout';
        } else {
          return response.json().then(err => { throw err; });
        }
      })
      .catch(error => {
        console.error('Error adding to cart:', error);
        basketError.textContent = "An error occurred. Make sure all fish categories have products assigned in the Theme Editor.";
        basketError.style.display = 'block';
        addToBasketBtn.disabled = false;
        addToBasketBtn.textContent = "Proceed to Payment";
      });
    });
  });
</script>
