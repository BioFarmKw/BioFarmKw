{% comment %}
  Fill Your Basket - Premium Redesign
  - Vegetable Basket: 9.500 KD Fixed Limit (Value-based progress)
  - Fish Basket: 5 KG Minimum (Weight-based progress)
{% endcomment %}

<style>
  :root {
    --veg-green: #4CAF50;
    --fish-blue: #2196F3;
    --ui-white: #ffffff;
    --ui-border: #f0f0f0;
    --ui-text-bold: #222222;
    --ui-text-soft: #666666;
    --ui-bg-soft: #fbfbfb;
  }

  .fill-basket-section {
    padding: 0;
    font-family: inherit;
    background: var(--ui-white);
  }

  /* Progress Bar UI */
  .basket-progress-card {
    background: var(--ui-white);
    border: 1px solid var(--ui-border);
    border-radius: 20px;
    padding: 25px;
    margin-bottom: 30px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.03);
  }

  .progress-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
  }

  .progress-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--ui-text-bold);
  }

  .progress-value {
    font-size: 16px;
    font-weight: 600;
  }

  .progress-bar-container {
    height: 12px;
    background: #eeeeee;
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 10px;
  }

  .progress-bar-fill {
    height: 100%;
    width: 0%;
    transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1), background 0.3s;
  }

  .progress-status-text {
    font-size: 13px;
    font-weight: 500;
    color: var(--ui-text-soft);
    text-align: center;
  }

  /* List of Items */
  .item-list-container {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .basket-item-card {
    background: var(--ui-white);
    border: 1px solid var(--ui-border);
    border-radius: 16px;
    padding: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: transform 0.2s, border-color 0.2s;
  }

  .basket-item-card:hover {
    border-color: #ddd;
  }

  .item-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .item-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--ui-text-bold);
  }

  .item-subtitle {
    font-size: 12px;
    color: var(--ui-text-soft);
    font-weight: 500;
  }

  .item-price-tag {
    font-size: 14px;
    font-weight: 700;
    color: var(--ui-text-bold);
  }

  /* Quantity Selector Premium */
  .qty-selector-premium {
    display: flex;
    align-items: center;
    background: var(--ui-bg-soft);
    border-radius: 12px;
    padding: 4px;
    gap: 8px;
    border: 1px solid #eee;
  }

  .qty-btn {
    width: 32px;
    height: 32px;
    border-radius: 10px;
    border: none;
    background: var(--ui-white);
    color: var(--ui-text-bold);
    font-size: 20px;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    transition: all 0.2s;
  }

  .qty-btn:hover {
    background: #f0f0f0;
  }

  .qty-btn:active {
    transform: scale(0.9);
  }

  .qty-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
    background: #e0e0e0;
  }

  .qty-display {
    width: 30px;
    text-align: center;
    font-size: 16px;
    font-weight: 700;
    color: var(--ui-text-bold);
  }

  /* Summary & CTA */
  .basket-footer {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--ui-border);
    text-align: center;
  }

  .footer-subtotal {
    font-size: 22px;
    font-weight: 800;
    color: var(--ui-text-bold);
    margin-bottom: 20px;
  }

  .cta-button-premium {
    width: 100%;
    padding: 18px;
    background: #222;
    color: #fff;
    border: none;
    border-radius: 40px;
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: all 0.3s;
  }

  .cta-button-premium:disabled {
    background: #d0d0d0;
    cursor: not-allowed;
  }

  .footer-links {
    margin-top: 15px;
  }

  .footer-link {
    color: var(--ui-text-soft);
    text-decoration: underline;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
  }

  .error-toast {
    background: #fff5f5;
    color: #c53030;
    padding: 12px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 600;
    margin-top: 15px;
    border: 1px solid #feb2b2;
    display: none;
  }
</style>

<!-- FISH MODAL -->
<modal-dialog id="Fish-Basket-Modal" class="modal">
  <div class="modal-overlay"></div>
  <div class="modal-inner gradient focus-none" role="dialog" aria-modal="true" tabindex="-1">
    <button class="modal-close-button button button--icon" onclick="this.closest('.modal').hide()">{% render 'icon-sets-basic', icon: 'close' %}</button>
    <div class="modal-content" style="max-height: 90vh; overflow-y: auto; padding: 25px;">
      <div class="fill-basket-section">
        <div class="fill-basket-header"><h2>Build Your Fish Basket</h2></div>
        
        <!-- Progress Card -->
        <div class="basket-progress-card">
          <div class="progress-header">
            <span class="progress-title">Fish Weight</span>
            <span class="progress-value"><span id="fishWeightCurrent">0</span> / 5 KG</span>
          </div>
          <div class="progress-bar-container">
            <div id="fishProgressBar" class="progress-bar-fill" style="background: var(--fish-blue);"></div>
          </div>
          <div class="progress-status-text" id="fishStatusText">Select minimum 5 KG fish</div>
        </div>

        <!-- Fish Items -->
        <div class="item-list-container">
          {% assign fish_cats = "small,small_medium,medium,large" | split: "," %}
          {% for cat in fish_cats %}
            {% capture key %}fish_{{ cat }}{% endcapture %}
            {% assign prod = all_products[section.settings[key]] %}
            {% case cat %}
              {% when 'small' %}{% assign weight = "500g – 600g" %}{% assign price = 1.500 %}
              {% when 'small_medium' %}{% assign weight = "650g – 750g" %}{% assign price = 1.750 %}
              {% when 'medium' %}{% assign weight = "800g – 2000g" %}{% assign price = 2.000 %}
              {% when 'large' %}{% assign weight = "2000g+" %}{% assign price = 2.500 %}
            {% endcase %}
            
            <div class="basket-item-card">
              <div class="item-info">
                <span class="item-title">{{ prod.title | default: cat | replace: '_', ' ' | capitalize }}</span>
                <span class="item-subtitle">{{ weight }} • {{ price | parseFloat | number_with_delimiter: precision: 3 }} KD / KG</span>
              </div>
              <div class="qty-selector-premium">
                <button class="qty-btn" data-action="minus" data-type="fish">-</button>
                <div class="qty-display" data-cat="{{ cat }}" data-price="{{ price }}" data-vid="{{ prod.variants.first.id }}">0</div>
                <button class="qty-btn" data-action="plus" data-type="fish">+</button>
              </div>
            </div>
          {% endfor %}
        </div>

        <div class="basket-footer">
          <div class="footer-subtotal">Subtotal: <span id="fishSubtotal">0.000</span> KD</div>
          <button class="cta-button-premium" id="fishCheckoutBtn" disabled>Select Minimum 5 KG Fish</button>
          <div class="error-toast" id="fishErrorToast"></div>
        </div>
      </div>
    </div>
  </div>
</modal-dialog>

<!-- VEGETABLE MODAL -->
<modal-dialog id="Veg-Basket-Modal" class="modal">
  <div class="modal-overlay"></div>
  <div class="modal-inner gradient focus-none" role="dialog" aria-modal="true" tabindex="-1">
    <button class="modal-close-button button button--icon" onclick="this.closest('.modal').hide()">{% render 'icon-sets-basic', icon: 'close' %}</button>
    <div class="modal-content" style="max-height: 90vh; overflow-y: auto; padding: 25px;">
      <div class="fill-basket-section">
        <div class="fill-basket-header"><h2>Build Your Vegetable Basket</h2></div>

        <!-- Progress Card -->
        <div class="basket-progress-card">
          <div class="progress-header">
            <span class="progress-title">Basket Value</span>
            <span class="progress-value"><span id="vegValueCurrent">0.000</span> / 9.500 KD</span>
          </div>
          <div class="progress-bar-container">
            <div id="vegProgressBar" class="progress-bar-fill" style="background: var(--veg-green);"></div>
          </div>
          <div class="progress-status-text" id="vegStatusText">Please complete your 9.500 KD vegetable basket</div>
        </div>

        <!-- Vegetable Items (Blocks) -->
        <div class="item-list-container">
          {% for block in section.blocks %}
            {% if block.type == 'vegetable_item' %}
              {% assign prod = all_products[block.settings.product] %}
              <div class="basket-item-card">
                <div class="item-info">
                  <span class="item-title">{{ prod.title | default: block.settings.name }}</span>
                  <span class="item-price-tag">{{ block.settings.price | number_with_delimiter: precision: 3 }} KD</span>
                </div>
                <div class="qty-selector-premium">
                  <button class="qty-btn" data-action="minus" data-type="veg">-</button>
                  <div class="qty-display" data-cat="{{ block.id }}" data-price="{{ block.settings.price }}" data-vid="{{ prod.variants.first.id }}">0</div>
                  <button class="qty-btn" data-action="plus" data-type="veg">+</button>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <div class="basket-footer">
          <div class="footer-subtotal">Price: 9.500 KD</div>
          <button class="cta-button-premium" id="vegCheckoutBtn" disabled>Build Your Basket</button>
          <div class="error-toast" id="vegErrorToast"></div>
          <div class="footer-links">
            <a class="footer-link" href="{{ routes.all_products_collection_url }}">Vegetable Categories</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</modal-dialog>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // --- UTILS ---
    const formatPrice = (p) => p.toFixed(3);
    const getCartTotal = async () => {
      const r = await fetch('/cart.js');
      const cart = await r.json();
      return cart.total_price / 1000; // Assuming KD uses 1000 sub-units or is direct
    };

    // --- LOGIC ---
    const handleQty = (e) => {
      const btn = e.currentTarget;
      const display = btn.parentElement.querySelector('.qty-display');
      let val = parseInt(display.textContent);
      const isPlus = btn.dataset.action === 'plus';
      const type = btn.dataset.type;

      if (isPlus) {
        // Veg limit check
        if (type === 'veg') {
          const price = parseFloat(display.dataset.price);
          let currentTotal = 0;
          document.querySelectorAll('.qty-display[data-type="veg"]').forEach(d => {
             currentTotal += parseInt(d.textContent) * parseFloat(d.dataset.price);
          });
          if (currentTotal + price > 9.5001) return; // Strict limit
        }
        val++;
      } else {
        if (val > 0) val--;
      }
      display.textContent = val;
      
      if (type === 'fish') updateFish();
      else updateVeg();
    };

    document.querySelectorAll('.qty-btn').forEach(b => {
      // Add type to qty display for easy selection
      const type = b.dataset.type;
      b.parentElement.querySelector('.qty-display').dataset.type = type;
      b.addEventListener('click', handleQty);
    });

    // --- FISH UPDATE ---
    const updateFish = () => {
      let weight = 0;
      let price = 0;
      let selections = [];
      document.querySelectorAll('.qty-display[data-type="fish"]').forEach(d => {
        let q = parseInt(d.textContent);
        if (q > 0) {
          weight += q;
          price += q * parseFloat(d.dataset.price);
          selections.push(`${q} KG ${d.dataset.cat}`);
        }
      });

      document.getElementById('fishWeightCurrent').textContent = weight;
      document.getElementById('fishSubtotal').textContent = formatPrice(price);
      const fill = (weight / 5) * 100;
      document.getElementById('fishProgressBar').style.width = Math.min(fill, 100) + '%';
      
      const btn = document.getElementById('fishCheckoutBtn');
      const status = document.getElementById('fishStatusText');
      
      if (weight >= 5) {
        btn.disabled = false;
        btn.textContent = "Proceed to Payment";
        status.textContent = "Minimum weight reached!";
        document.getElementById('fishProgressBar').style.background = "var(--fish-blue)";
      } else {
        btn.disabled = true;
        btn.textContent = "Select minimum 5 KG fish";
        status.textContent = "Select minimum 5 KG fish";
        document.getElementById('fishProgressBar').style.background = "#2196F3";
      }
    };

    // --- VEG UPDATE ---
    const updateVeg = () => {
      let totalValue = 0;
      document.querySelectorAll('.qty-display[data-type="veg"]').forEach(d => {
        totalValue += parseInt(d.textContent) * parseFloat(d.dataset.price);
      });

      document.getElementById('vegValueCurrent').textContent = formatPrice(totalValue);
      const fill = (totalValue / 9.5) * 100;
      document.getElementById('vegProgressBar').style.width = Math.min(fill, 100) + '%';
      
      const btn = document.getElementById('vegCheckoutBtn');
      const status = document.getElementById('vegStatusText');
      
      // Disable plus buttons if limit reached or adding would exceed limit
      document.querySelectorAll('.qty-btn[data-action="plus"][data-type="veg"]').forEach(b => {
        const display = b.parentElement.querySelector('.qty-display');
        const price = parseFloat(display.dataset.price);
        if (totalValue + price > 9.5001) {
          b.disabled = true;
        } else {
          b.disabled = false;
        }
      });

      if (Math.abs(totalValue - 9.5) < 0.001) {
        btn.disabled = false;
        btn.textContent = "Proceed to Payment";
        status.textContent = "Basket Complete! (9.500 / 9.500 KD)";
        document.getElementById('vegProgressBar').style.background = "var(--veg-green)";
      } else {
        btn.disabled = true;
        btn.textContent = "Build Your Basket";
        status.textContent = "Please complete your 9.500 KD vegetable basket";
        document.getElementById('vegProgressBar').style.background = "var(--veg-green)";
      }
    };

    // --- CHECKOUT LOGIC ---
    const handleCheckout = async (type) => {
      const isFish = type === 'fish';
      const btn = document.getElementById(isFish ? 'fishCheckoutBtn' : 'vegCheckoutBtn');
      const errorToast = document.getElementById(isFish ? 'fishErrorToast' : 'vegErrorToast');
      
      btn.disabled = true;
      btn.textContent = "Verifying...";
      errorToast.style.display = 'none';

      try {
        // Calculate items to add
        let itemsToAdd = [];
        let totalWeight = 0;
        let totalVal = 0;
        let selections = [];
        
        document.querySelectorAll(`.qty-display[data-type="${type}"]`).forEach(d => {
          let q = parseInt(d.textContent);
          if (q > 0) {
            itemsToAdd.push({ id: d.dataset.vid, quantity: q, properties: { '_basket_type': type } });
            totalWeight += q;
            totalVal += q * parseFloat(d.dataset.price);
            selections.push(`${q} ${isFish ? 'KG' : ''} ${d.dataset.cat}`);
          }
        });

        // Final Fish Validation
        if (isFish) {
          if (totalWeight < 5) throw "Minimum fish order is 5 KG";
          
          // Check Cart Total (Current + Potential)
          const cartTotal = await getCartTotal();
          if (cartTotal + totalVal < 10) throw "Cart total must be at least 10 KD";
        }

        // Add to Cart
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: itemsToAdd })
        });
        
        if (response.ok) {
          window.location.href = '/checkout';
        } else {
          throw "Failed to add items. Check product assignment.";
        }
      } catch (err) {
        errorToast.textContent = err;
        errorToast.style.display = 'block';
        btn.disabled = false;
        btn.textContent = "Proceed to Payment";
      }
    };

    document.getElementById('fishCheckoutBtn').addEventListener('click', () => handleCheckout('fish'));
    document.getElementById('vegCheckoutBtn').addEventListener('click', () => handleCheckout('veg'));
  });
</script>

{% schema %}
{
  "name": "Fill Your Basket",
  "settings": [
    { "type": "header", "content": "Fish Products" },
    { "type": "product", "id": "fish_small", "label": "Small Fish Product" },
    { "type": "product", "id": "fish_small_medium", "label": "Small Medium Fish Product" },
    { "type": "product", "id": "fish_medium", "label": "Medium Fish Product" },
    { "type": "product", "id": "fish_large", "label": "Large Fish Product" },
    { "type": "header", "content": "Vegetable Basket Settings" },
    { "type": "product", "id": "veg_bundle_product", "label": "Main Veg Bundle Product (if any)" }
  ],
  "blocks": [
    {
      "type": "vegetable_item",
      "name": "Vegetable Item",
      "settings": [
        { "type": "text", "id": "name", "label": "Display Name" },
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "number", "id": "price", "label": "Price (KD)", "default": 1 }
      ]
    }
  ]
}
{% endschema %}
