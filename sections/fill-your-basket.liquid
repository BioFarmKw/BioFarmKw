{% schema %}
{
  "name": "Fill Your Basket",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Fill Your Basket"
    },
    {
      "type": "header",
      "content": "Vegetable Basket"
    },
    {
      "type": "product",
      "id": "vegetable_product",
      "label": "Vegetable Product (Fixed 9.500 KD)"
    },
    {
      "type": "header",
      "content": "Fish Categories"
    },
    {
      "type": "product",
      "id": "fish_small",
      "label": "Small Fish (1.5 KD/kg)"
    },
    {
      "type": "product",
      "id": "fish_small_medium",
      "label": "Small Medium Fish (1.750 KD/kg)"
    },
    {
      "type": "product",
      "id": "fish_medium",
      "label": "Medium Fish (2 KD/kg)"
    },
    {
      "type": "product",
      "id": "fish_large",
      "label": "Large Fish (2.5 KD/kg)"
    }
  ],
  "presets": [
    {
      "name": "Fill Your Basket"
    }
  ]
}
{% endschema %}

<style>
  .fill-basket-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px;
    font-family: inherit;
  }
  .fill-basket-header {
    text-align: center;
    margin-bottom: 40px;
  }
  .fill-basket-header h2 {
    font-size: 32px;
    font-weight: bold;
    color: var(--color-foreground, #333);
  }
  .fill-basket-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
  }
  @media(min-width: 768px) {
    .fill-basket-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .basket-card {
    background: #ffffff;
    border-radius: 12px;
    padding: 24px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    border: 1px solid #eee;
  }
  .basket-card h3 {
    font-size: 20px;
    margin-bottom: 15px;
    color: #222;
    border-bottom: 2px solid #eee;
    padding-bottom: 10px;
  }
  
  /* Vegetable Toggle */
  .veg-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 15px;
    border: 2px solid #e0e0e0;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .veg-toggle.active {
    border-color: #4CAF50;
    background-color: #f1f8e9;
  }
  .veg-toggle input {
    display: none;
  }
  .veg-price {
    font-weight: bold;
    color: #4CAF50;
    font-size: 18px;
  }

  /* Fish Selection */
  .fish-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px;
    border: 1px solid #eee;
    border-radius: 6px;
    margin-bottom: 10px;
    cursor: pointer;
    transition: all 0.2s;
  }
  .fish-option:hover {
    background: #f9f9f9;
  }
  .fish-option input[type="radio"] {
    margin-right: 10px;
    accent-color: #2196F3;
  }
  .fish-details {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }
  .fish-title {
    font-weight: bold;
    font-size: 16px;
  }
  .fish-weight {
    font-size: 12px;
    color: #666;
  }
  .fish-price {
    font-weight: bold;
    color: #2196F3;
  }

  .qty-selector {
    margin-top: 20px;
  }
  .qty-selector label {
    display: block;
    font-weight: bold;
    margin-bottom: 8px;
  }
  .qty-input-group {
    display: flex;
    align-items: center;
  }
  .qty-input-group input {
    width: 80px;
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 4px;
    text-align: center;
    font-size: 16px;
  }
  .qty-unit {
    margin-left: 10px;
    font-weight: bold;
    color: #555;
  }

  /* Summary Section */
  .basket-summary {
    grid-column: 1 / -1;
    background: #fafafa;
    border-radius: 12px;
    padding: 24px;
    text-align: center;
    border: 1px solid #eee;
  }
  .subtotal-display {
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 20px;
    color: #333;
  }
  .add-to-basket-btn {
    background-color: #222;
    color: #fff;
    border: none;
    padding: 15px 40px;
    font-size: 18px;
    font-weight: bold;
    border-radius: 30px;
    cursor: pointer;
    transition: all 0.3s;
  }
  .add-to-basket-btn:hover {
    background-color: #4CAF50;
    transform: translateY(-2px);
  }
  .add-to-basket-btn:disabled {
    background-color: #ccc;
    cursor: not-allowed;
    transform: none;
  }
  
  .error-message {
    color: #d32f2f;
    margin-top: 10px;
    font-size: 14px;
    display: none;
  }

</style>

<div class="fill-basket-section" id="Fill-Basket-{{ section.id }}">
  <div class="fill-basket-header">
    <h2>{{ section.settings.title | escape }}</h2>
  </div>

  <div class="fill-basket-grid">
    <!-- Vegetables -->
    <div class="basket-card">
      <h3>Vegetable Basket</h3>
      <label class="veg-toggle" id="vegToggleLabel">
        <span>Assorted Fresh Vegetables</span>
        <span class="veg-price">9.500 KD</span>
        <input type="checkbox" id="vegCheckbox" 
          data-variant-id="{{ section.settings.vegetable_product.first_available_variant.id }}" 
          data-price="9.5">
      </label>
    </div>

    <!-- Fish -->
    <div class="basket-card">
      <h3>Fish Selection</h3>
      
      {% assign fish_small = section.settings.fish_small %}
      {% assign fish_sm_med = section.settings.fish_small_medium %}
      {% assign fish_medium = section.settings.fish_medium %}
      {% assign fish_large = section.settings.fish_large %}

      <div class="fish-options">
        <label class="fish-option">
          <input type="radio" name="fish_category" value="{{ fish_small.first_available_variant.id }}" data-price="1.5">
          <div class="fish-details">
            <span class="fish-title">Small Fish</span>
            <span class="fish-weight">500g - 600g</span>
          </div>
          <span class="fish-price">1.500 KD / kg</span>
        </label>

        <label class="fish-option">
          <input type="radio" name="fish_category" value="{{ fish_sm_med.first_available_variant.id }}" data-price="1.75">
          <div class="fish-details">
            <span class="fish-title">Small Medium Fish</span>
            <span class="fish-weight">650g - 750g</span>
          </div>
          <span class="fish-price">1.750 KD / kg</span>
        </label>

        <label class="fish-option">
          <input type="radio" name="fish_category" value="{{ fish_medium.first_available_variant.id }}" data-price="2.0">
          <div class="fish-details">
            <span class="fish-title">Medium Fish</span>
            <span class="fish-weight">800g - 2000g</span>
          </div>
          <span class="fish-price">2.000 KD / kg</span>
        </label>

        <label class="fish-option">
          <input type="radio" name="fish_category" value="{{ fish_large.first_available_variant.id }}" data-price="2.5">
          <div class="fish-details">
            <span class="fish-title">Large Fish</span>
            <span class="fish-weight">Above 2000g</span>
          </div>
          <span class="fish-price">2.500 KD / kg</span>
        </label>
      </div>

      <div class="qty-selector">
        <label for="fishQty">Quantity Required (Minimum 5 KG)</label>
        <div class="qty-input-group">
          <input type="number" id="fishQty" min="0" step="1" value="0">
          <span class="qty-unit">KG</span>
        </div>
        <div id="fishQtyError" class="error-message">Minimum fish order must be 5 KG.</div>
      </div>
    </div>

    <!-- Summary -->
    <div class="basket-summary">
      <div class="subtotal-display">
        Subtotal: <span id="basketSubtotal">0.000 KD</span>
      </div>
      <button class="add-to-basket-btn" id="addToBasketBtn">Add to Basket</button>
      <div id="basketError" class="error-message"></div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const vegCheckbox = document.getElementById('vegCheckbox');
    const vegToggleLabel = document.getElementById('vegToggleLabel');
    const fishRadios = document.querySelectorAll('input[name="fish_category"]');
    const fishQtyInput = document.getElementById('fishQty');
    const subtotalDisplay = document.getElementById('basketSubtotal');
    const addToBasketBtn = document.getElementById('addToBasketBtn');
    const fishQtyError = document.getElementById('fishQtyError');
    const basketError = document.getElementById('basketError');

    function calculateSubtotal() {
      let total = 0;
      
      // Veg
      if (vegCheckbox.checked) {
        total += parseFloat(vegCheckbox.dataset.price || 0);
        vegToggleLabel.classList.add('active');
      } else {
        vegToggleLabel.classList.remove('active');
      }

      // Fish
      let fishPrice = 0;
      fishRadios.forEach(radio => {
        if (radio.checked) {
          fishPrice = parseFloat(radio.dataset.price || 0);
        }
      });
      
      let qty = parseInt(fishQtyInput.value) || 0;
      total += (fishPrice * qty);

      subtotalDisplay.textContent = total.toFixed(3) + ' KD';
      
      // Validation UI
      if (qty > 0 && qty < 5) {
        fishQtyError.style.display = 'block';
        addToBasketBtn.disabled = true;
      } else {
        fishQtyError.style.display = 'none';
        addToBasketBtn.disabled = false;
      }
    }

    vegCheckbox.addEventListener('change', calculateSubtotal);
    fishRadios.forEach(radio => radio.addEventListener('change', calculateSubtotal));
    fishQtyInput.addEventListener('input', calculateSubtotal);

    addToBasketBtn.addEventListener('click', function() {
      let items = [];
      let fishQty = parseInt(fishQtyInput.value) || 0;
      
      if (fishQty > 0 && fishQty < 5) {
        fishQtyError.style.display = 'block';
        return;
      }

      if (vegCheckbox.checked) {
        const vegId = vegCheckbox.dataset.variantId;
        if (vegId) {
          items.push({
            id: vegId,
            quantity: 1
          });
        }
      }

      if (fishQty >= 5) {
        let selectedFishId = null;
        fishRadios.forEach(radio => {
          if (radio.checked) selectedFishId = radio.value;
        });

        if (selectedFishId) {
          items.push({
            id: selectedFishId,
            quantity: fishQty,
            properties: {
              '_is_fish': 'true' // Hidden property for cart validation
            }
          });
        } else {
          basketError.textContent = "Please select a fish category.";
          basketError.style.display = 'block';
          return;
        }
      }

      if (items.length === 0) {
        basketError.textContent = "Please select items to add to your basket.";
        basketError.style.display = 'block';
        return;
      }

      basketError.style.display = 'none';
      addToBasketBtn.disabled = true;
      addToBasketBtn.textContent = "Adding...";

      // AJAX Add to Cart
      fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ items: items })
      })
      .then(response => {
        if (response.ok) {
          // Success: trigger cart update
          addToBasketBtn.textContent = "Added to Basket!";
          setTimeout(() => {
            addToBasketBtn.textContent = "Add to Basket";
            addToBasketBtn.disabled = false;
          }, 2000);
          
          // Refresh page or trigger theme drawer update
          if (window.location.pathname !== '/cart') {
             window.location.href = '/cart'; // Fallback to cart page
          } else {
             location.reload();
          }
        } else {
          return response.json().then(err => { throw err; });
        }
      })
      .catch(error => {
        console.error('Error adding to cart:', error);
        basketError.textContent = "An error occurred while adding to cart. Ensure products are set up in Theme Editor.";
        basketError.style.display = 'block';
        addToBasketBtn.disabled = false;
        addToBasketBtn.textContent = "Add to Basket";
      });
    });
  });
</script>
