    "shop_the_feed_y4x4zc": {
      "type": "shop-the-feed",
      "blocks": {
        "image_feed_WLeYNd": {
          "type": "image-feed",
          "settings": {
            "image": "shopify://shop_images/kale.png",
            "description": "<p>At Biofarm, we operate using<strong>Aquaponics technology</strong>, a sustainable and environmentally friendly farming system that mimics natural ecosystems.</p>",
            "product": "peace-lily"
          }
        },
        "video_feed_ghYcAg": {
          "type": "video-feed",
          "settings": {
            "video": "shopify://files/videos/Prod.mp4",
            "description": "<p>beneficial microorganisms, and aquatic life, all connected through a closed-loop water system.</p><p>This integrated organic system consists of a fish environment, beneficial bacterial environment, and plant-growing environment. It accepts no external inputs that could disturb the ecological balance. As a result, agricultural and fish products are naturally formed in nutrients, taste, and appearance.</p>",
            "product": "aloe-vera"
          }
        },
        "image_feed_RRqkMW": {
          "type": "image-feed",
          "settings": {
            "image": "shopify://shop_images/MatadorSpinach2026-02-10011601.png",
            "description": "<ul><li>Clean, nutritious and healthy</li><li>Raised in fresh water</li><li>Fed high-quality healthy feed</li><li>Eco-friendly tank systems</li><li>Protected greenhouse environments</li><li>Continuous technical supervision</li></ul>",
            "product": "fern"
          }
        },
        "video_feed_J9pPzg": {
          "type": "video-feed",
          "settings": {
            "video": "shopify://files/videos/SecondProductVideo.mp4",
            "description": "<p><br/>There is growing concern regarding agricultural products due to lack of oversight on quality standards and health regulations. Issues include pesticide residues, chemical fertilizers, hormones, and unsafe farming practices.<br/><br/><br/></p>",
            "product": "bird-of-paradise"
          }
        },
        "image_feed_6LxfXp": {
          "type": "image-feed",
          "settings": {
            "image": "shopify://shop_images/LaurelSpinach2026-02-10011937.png",
            "description": "<p>Calm spaces, happy places.<br/>Florona plants turn any room into your personal green retreat. 🌿💫<br/><br/>#FloronaPlants #GreenLifestyle #PeacefulLiving #FloronaTouch</p>",
            "product": "philodendron"
          }
        },
        "image_feed_h4Fj7L": {
          "type": "image-feed",
          "settings": {
            "image": "shopify://shop_images/SliderImage_5a631d4e-e26b-4e00-a847-a063de27844a.png",
            "description": "<p>Another concern is insufficient supervision and untrained labor, leading to misuse of prohibited substances and unsafe fertilizers. Imported products also face weak regulation and misleading labeling, reducing consumer trust.<br/><br/></p>",
            "product": "snake-plant"
          }
        }
      },
